# Safe local foundation defaults. Never put API keys or tokens in this file.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
LLM_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=350
EDITORIAL_DATABASE_PATH=.local/editorial.sqlite3
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_EMBEDDING_REVISION=main
RAG_CHROMA_COLLECTION=business-context
RAG_CHROMA_PERSIST_DIRECTORY=.local/chroma
RAG_API_BASE_URL=https://jsonplaceholder.typicode.com

# Local sign-in (generate with: python scripts/create_auth_user.py gabriela)
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
AUTH_SECRET=
AUTH_TOKEN_TTL_MINUTES=480
